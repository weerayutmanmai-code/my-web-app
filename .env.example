# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# พอร์ตของเว็บ
PORT=3000

# จาก LINE Developers Console > Provider > Messaging API channel
#   Basic settings   > Channel secret
#   Messaging API    > Channel access token (long-lived)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ชื่อผู้ใช้/รหัสผ่านสำหรับเข้าหน้าเว็บสำนักงาน (จำเป็นเมื่อ NODE_ENV=production)
ADMIN_USER=admin
ADMIN_PASSWORD=

# โฟลเดอร์เก็บฐานข้อมูล (app.db) และรูปจากหน้างาน (uploads/)
DATA_DIR=./data

# true = ผู้คุมงานที่เพิ่มเพื่อนบอทใช้งานได้ทันที ไม่ต้องรอสำนักงานอนุมัติ
AUTO_APPROVE=false
