{
  "name": "my-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "LINE chatbot เป็นตัวกลางสื่อสารระหว่างผู้คุมงานกับเว็บแอปของสำนักงาน",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
